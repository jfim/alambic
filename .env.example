# Copy this file to .env and fill in the values. .env is gitignored.
# Source it before running mix: `source .env && mix phx.server`.

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname (no scheme), e.g. alambic.example.com
PHX_HOST=

# Database URL. Used in both dev and prod when set; falls back to localhost
# defaults in config/dev.exs when unset. Format:
#   postgresql://USER:PASS@HOST:PORT/DATABASE
DATABASE_URL=

# Base URL of the archive API (used by the correction UI to fetch artifacts)
ARCHIVE_BASE_URL=

# Postgres password (used by docker-compose; not needed for direct mix dev runs)
POSTGRES_PASSWORD=alambic

# Review queue threshold — items with confidence below this are queued
REVIEW_CONFIDENCE_THRESHOLD=0.7

# Optional, defaults to 4000
PORT=4000

# Cham filename for the extracted HTML artifact per item
CHAM_EXTRACTION_HTML_FILENAME=original.html

# Cham filename for the cleaning content (post-extraction markdown) per item
CHAM_CLEANING_CONTENT_FILENAME=content.md

# Blob storage path. Required in prod. Optional in dev — defaults to
# tmp/blobs relative to the working directory; set to an absolute path
# to share one blob store across multiple git worktrees.
BLOB_STORAGE_PATH=
